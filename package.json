{
    "name": "dotfiles",
    "version": "1.0.0",
    "description": "Repository for configuring and setting up my key dotfiles",
    "main": "index.ts",
    "scripts": {
        "configure": "npm run tsc && node dist/index.js",
        "test": "jest",
        "lint": "eslint .",
        "lint:fix": "eslint --fix .",
        "pretsc": "if [ -d ./dist ]; then rm -r ./dist; fi",
        "tsc": "tsc -p tsconfig.build.json",
        "posttsc": "cp -r src/assets/ dist/assets/"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/W-E-Robinson/dotfiles.git"
    },
    "keywords": [
        "dotfiles"
    ],
    "author": "Will Robinson (github: W-E-Robinson)",
    "license": "ISC",
    "bugs": {
        "url": "https://github.com/W-E-Robinson/dotfiles/issues"
    },
    "homepage": "https://github.com/W-E-Robinson/dotfiles#readme",
    "dependencies": {
        "enquirer": "^2.4.1"
    },
    "devDependencies": {
        "@stylistic/eslint-plugin": "^2.13.0",
        "@types/jest": "^30.0.0",
        "@typescript-eslint/eslint-plugin": "^8.72.0",
        "@typescript-eslint/parser": "^8.72.0",
        "eslint": "^8.57.0",
        "eslint-config-airbnb-base": "^15.0.0",
        "eslint-config-airbnb-typescript": "^18.0.0",
        "eslint-config-standard": "^17.1.0",
        "eslint-plugin-import": "^2.29.1",
        "eslint-plugin-jest": "^28.8.0",
        "eslint-plugin-n": "^16.6.2",
        "eslint-plugin-promise": "^6.1.1",
        "jest": "^30.5.2",
        "ts-jest": "^29.4.15",
        "typescript": "^5.4.5"
    },
    "jest": {
        "preset": "ts-jest",
        "testMatch": [
            "**/?(*.)+(spec|test).ts"
        ]
    },
    "engines": {
        "node": ">=22.0.0"
    },
    "overrides": {
        "@istanbuljs/load-nyc-config": {
            "js-yaml": "^4.1.0"
        },
        "eslint-config-airbnb-typescript": {
            "@typescript-eslint/eslint-plugin": "$@typescript-eslint/eslint-plugin",
            "@typescript-eslint/parser": "$@typescript-eslint/parser"
        }
    }
}
