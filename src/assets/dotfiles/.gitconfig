[push]
    default = current
[user]
    name = Will Robinson
    email = william.ellis.robinson@gmail.com
[init]
    defaultBranch = main
[core]
    editor = nvim
    pager = delta
[rerere]
    enabled = true
    autoUpdate = true
[branch]
    sort = -committerdate
[alias]
    bomb = restore .
    nuke = !git restore . && git clean -fd
    st = status
    c = commit
    s = switch
    b = branch -vv
    d = diff
    ds = diff --staged
    m = merge
    r = rebase
    ref = reflog
    ap = add -p
    rp = restore -p
    f = fetch
    fa = fetch -a
    cp = cherry-pick
    bl = blame -w -C -C -C
    pl = pull
    ps = push
    psf = push --force-with-lease
[interactive]
    diffFilter = delta --color-only
[delta]
    navigate = true # use n and N to move between diff sections
    dark = true
    side-by-side = true
[merge]
    conflictStyle = zdiff3
